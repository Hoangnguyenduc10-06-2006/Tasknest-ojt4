# Run python3 scripts/setup-local.py to generate .env with unique local credentials.
# These are local scaffold settings, not production secrets.
COMPOSE_PROJECT_NAME=tasknest
FRONTEND_PORT=3000
CONFIG_USERNAME=tasknest_config
CONFIG_PASSWORD=
DISCOVERY_USERNAME=tasknest_discovery
DISCOVERY_PASSWORD=
SCAFFOLD_SECURITY_PASSWORD=
MYSQL_ROOT_PASSWORD=
IDENTITY_DB_PASSWORD=
WORK_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=
RABBITMQ_USERNAME=tasknest
RABBITMQ_PASSWORD=

# Durable auth keys: generated locally, never commit .env or reuse sample keys.
IDENTITY_JWT_PRIVATE_KEY_BASE64=
IDENTITY_OUTBOX_KEY_BASE64=
IDENTITY_OUTBOX_KEY_ID=
IDENTITY_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
IDENTITY_COOKIE_SECURE=true

# Fixed-window budgets count requests, including successful requests.
AUTH_LOGIN_ACCOUNT_ATTEMPTS=10
AUTH_LOGIN_ADDRESS_ATTEMPTS=100
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_REFRESH_SESSION_ATTEMPTS=30
AUTH_REFRESH_ADDRESS_ATTEMPTS=100
AUTH_REFRESH_WINDOW_SECONDS=60

# Enable after configuring Brevo sender and the public FRONTEND origin.
MAIL_ENABLED=false
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=TaskNest
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=
PUBLIC_APP_ORIGIN=http://localhost:3000

# Private ingress/Gateway/Identity trust key; generated by setup-auth-secrets.py.
TASKNEST_PROXY_KEY=

# Production MySQL access: loopback by default. Direct access requires client IPv4.
MYSQL_ACCESS_BIND=127.0.0.1
MYSQL_ACCESS_PORT=13307
MYSQL_ACCESS_ALLOWED_IP=

# Optional AI foundation. Run scripts/setup-ai.py for existing .env / MySQL volumes.
# After provisioning the AI database, use COMPOSE_PROFILES=ai with local Compose.
# Production deploys include AI automatically when AI_ENABLED=true and AI_DB_PASSWORD is set.
AI_DB_PASSWORD=
AI_ENABLED=false
# Supported values: groq, openrouter. Set AI_API_KEY for the chosen provider.
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
# Optional fallback is tried automatically only after the primary provider returns rate-limit/quota.
AI_FALLBACK_API_KEY=
AI_FALLBACK_PROVIDER=openrouter
AI_FALLBACK_MODEL=openrouter/free
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_USER_DAILY_LIMIT=60
AI_GLOBAL_DAILY_LIMIT=300
